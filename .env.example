# ==============================================================================
# gemini-live-dashboard Environment Configuration
# ==============================================================================

# Gemini Live & Generative AI Credentials (Required for AI features)
GEMINI_API_KEY=ضع_مفتاحك_هنا
# GEMINI_MODEL=gemini-3.8-live
# GEMINI_VOICE=Sulafat
# GEMINI_API_VERSION=v1alpha

# Application Server Settings
PORT=3000
# ACCESS_CODE=               # رمز حماية اختياري للواجهة والـ API
# LOCK_CONFIG=true
# ALLOW_WRITES=true

# Database Configuration (PostgreSQL)
# Used automatically by Docker Compose; fallback to local SQLite if omitted
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gemini_dashboard
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@db:5432/gemini_dashboard

# Storage & Ingestion Settings
# INGEST_STORAGE=local       # 'local' or 'drive'
# INGEST_LOCAL_DIR=/app/ingest-data
# DRIVE_SCRIPT_URL=
