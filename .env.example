# ==============================================================================
# TUJAR ASSISTANT / GEMINI LIVE DASHBOARD — COMPLETE ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & SECURITY (REQUIRED)
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=production

# Optional: Set a PIN code to password-protect the public dashboard and API.
# Leave blank for open access (e.g., local development).
ACCESS_CODE=

# CORS origin for separated frontend (e.g. Vercel) or '*' for all origins.
CORS_ORIGIN=*

# Lock system instruction and tools to prevent client-side override (true/false)
LOCK_CONFIG=true
ALLOW_WRITES=true


# ------------------------------------------------------------------------------
# 2. DATABASE — NEON POSTGRESQL (REQUIRED FOR PERSISTENCE)
# ------------------------------------------------------------------------------
# Copy from Neon Console: https://console.neon.tech/app/projects/empty-unit-87438964
# Format: postgresql://[USER]:[PASSWORD]@[ENDPOINT].us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://[USER]:[PASSWORD]@ep-empty-unit-87438964.us-east-2.aws.neon.tech/neondb?sslmode=require


# ------------------------------------------------------------------------------
# 3. GEMINI AI & VOICE ENGINE (REQUIRED FOR DEFAULT ASSISTANT "NORA")
# ------------------------------------------------------------------------------
# Get your free Gemini API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini Live Model & Voice (Nora)
# Female voices supported: Sulafat, Despina, Aoede, Leda, Kore, Zephyr
GEMINI_MODEL=gemini-3.8-live
GEMINI_VOICE=Sulafat
GEMINI_API_VERSION=v1alpha
TTS_MODEL=gemini-3.8-flash-tts
THINKING_LEVEL=medium

# Optional: Custom voice clone ID for Gemini TTS
MY_VOICE_ID=voice_xb1ye60p9o3i


# ------------------------------------------------------------------------------
# 4. ELEVENLABS ENGINE (OPTIONAL — FOR "FAWAZ" & "JEDDAWI" PERSONAS)
# ------------------------------------------------------------------------------
# Get your API key from: https://elevenlabs.io
ELEVENLABS_API_KEY=
ELEVEN_MODEL=eleven_realtime_v1_max
ELEVEN_PERSONA=فواز
ELEVEN_VOICE=si9mYqRfqKHdK2kDRssy
FAWAZ_VOICE=si9mYqRfqKHdK2kDRssy
JEDDAWI_VOICE=bIHbv24MWmeRgasZH58o
JEDDAWI_TTS_MODEL=eleven_v4_turbo


# ------------------------------------------------------------------------------
# 5. GOOGLE DRIVE SYNC (OPTIONAL — FOR AUTOMATED DOCUMENT ARCHIVAL)
# ------------------------------------------------------------------------------
# Apps Script deployment URL that syncs uploaded files to Google Drive
DRIVE_SCRIPT_URL=https://script.google.com/macros/s/AKfycbyOJiN5RiiidyE9BB6qAI5d-q3uO5Vxp-xBTl5qRZMxmhEZgqt67ORmeGdzigyVnFgr/exec
DRIVE_SYNC_INTERVAL_SEC=60


# ------------------------------------------------------------------------------
# 6. OBJECT STORAGE / CLOUDFLARE R2 / AWS S3 (OPTIONAL)
# ------------------------------------------------------------------------------
# By default, files are stored locally in /ingest-data/ or synced to Drive.
# To use Cloudflare R2 / AWS S3 / MinIO, set STORAGE_TYPE=s3:
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=./ingest-data

# If STORAGE_TYPE=s3:
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_BUCKET=tujar-documents
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto


# ------------------------------------------------------------------------------
# 7. DOCUMENT INGESTION & AUTO-DK SYNTHESIS
# ------------------------------------------------------------------------------
AUTO_DK_MODEL=gemini-3.8-flash
INGEST_MODEL=gemini-3.8-flash
DIGEST_MODEL=gemini-3.8-flash
EMBED_MODEL=gemini-embedding-001
INGEST_CONCURRENCY=3
INGEST_PAGE_TIMEOUT_MS=45000
